# 1. Беремо базовий образ Node.js
FROM node:18-alpine

# 2. Створюємо робочу папку
WORKDIR /app

# 3. Копіюємо залежності
COPY package*.json ./

# 4. Встановлюємо залежності
RUN npm install

# 5. Копіюємо весь код фронтенду
COPY . .

# 6. Відкриваємо порт 3000
EXPOSE 3000

# 7. Команда для запуску Next.js у режимі розробки
CMD ["npm", "run", "dev"]